# Devnet only. Copy to .env (gitignored). Never commit real keys.

# Dedicated RPC (QuickNode or Helius free tier). NOT the public devnet RPC.
SVM_RPC_URL=

# Server (seller)
SVM_ADDRESS=                          # payTo wallet (public key)
SVM_RECEIVER_AUTHORIZER_PRIVATE_KEY=  # signs settle vouchers
FACILITATOR_URL=http://localhost:4022
PORT=3000

# Self-hosted facilitator (needs funded devnet SOL for fees/rent)
SVM_PRIVATE_KEY=

# Agent (buyer)
AGENT_SVM_PRIVATE_KEY=
AGENT_PER_REPORT_CAP_USD=0.25
AGENT_SESSION_BUDGET_USD=2.00
AGENT_APPROVAL_THRESHOLD_USD=0.25

# Verifier limits
VERIFIER_TIMEOUT_SECONDS=60
VERIFIER_MAX_CONCURRENT=2
MAX_INPUT_BYTES=65536
