# Devnet only. Copy to .env (gitignored). Never commit real keys.

# Dedicated RPC (QuickNode or Helius free tier). NOT the public devnet RPC.
SVM_RPC_URL=

# --- Server (seller) ---
# SVM_ADDRESS is the payTo wallet (public key).
SVM_ADDRESS=
# SVM_RECEIVER_AUTHORIZER_PRIVATE_KEY signs settle vouchers.
SVM_RECEIVER_AUTHORIZER_PRIVATE_KEY=
SERVER_PORT=4021
FACILITATOR_URL=http://localhost:4022
# Do not set PORT here: the facilitator reads PORT, so start it with FACILITATOR_PORT (4022).
FACILITATOR_PORT=4022

# --- Self-hosted facilitator (needs funded devnet SOL for fees/rent) ---
SVM_PRIVATE_KEY=

# --- Agent (buyer) ---
AGENT_SVM_PRIVATE_KEY=
AGENT_ALLOWED_URL=http://localhost:4021/report
AGENT_PER_REPORT_CAP_USD=0.25
AGENT_SESSION_BUDGET_USD=2.00
AGENT_APPROVAL_THRESHOLD_USD=0.10
# Set to 0.25 for non-interactive demo runs. Empty means it prompts on every report.
AGENT_AUTO_APPROVE_USD=
AGENT_RETRY_BUDGET=3
AGENT_LOG_PATH=agent/decisions.log

# --- Verifier limits ---
VERIFIER_TIMEOUT_SECONDS=60
VERIFIER_MAX_CONCURRENT=2
MAX_INPUT_BYTES=65536
RATE_LIMIT_SECONDS=10
SETTLEMENT_POLL_SECONDS=45

# --- Verifier (real: needs an amd64 host with Docker) ---
VERIFIER_CASE=42482847
VERIFIER_PYTHON=python3
# Test mode only. Leave unset for the real verifier and the demo.
# Stub runs also need VERIFIER_PATH=verifier/verify_stub.py and VERIFIER_CASE unset.
# ALLOW_STUB_VERIFIER=1

SVM_RECEIVER_AUTHORIZER_PRIVATE_KEY=

# Separate devnet-only signing key for the verdict log. Not a payment key.
LOG_SIGNING_KEY=
LOG_PATH=server/verdicts.jsonl
